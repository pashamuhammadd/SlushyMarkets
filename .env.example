# Feedback storage (Supabase). Copy to .env.local for local development.
# Server only. Never expose the secret key to the browser or prefix it with NEXT_PUBLIC_.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Optional. Google Search Console "HTML tag" verification token (only the content value, not the whole tag).
# Not a secret, but kept out of the code so it can change without a commit.
GOOGLE_SITE_VERIFICATION=
